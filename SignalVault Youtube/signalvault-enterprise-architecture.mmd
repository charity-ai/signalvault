flowchart LR
    subgraph Edge[Secure edge]
        User[Brand user or agency operator]
        EdgeAccess[SSO, MFA, WAF and rate limits]
    end

    subgraph App[SignalVault application services]
        API[API and workspace authorization]
        Query[Retrieval and citation service]
        Admin[Billing, source controls and audit portal]
    end

    subgraph Control[System of record]
        PG[(Managed PostgreSQL\norganizations, brands, workspaces, roles\nsource registry, citation manifests, billing)]
        Obj[(Encrypted object storage\noptional approved transcript evidence\nexports, never copied video files)]
        Audit[(Immutable audit and security events)]
    end

    subgraph Jobs[Asynchronous ingestion]
        Queue[Durable queue and dead-letter queue]
        Worker[Idempotent ingestion workers]
        Embed[Chunking and embedding workers]
    end

    subgraph Retrieval[Enterprise retrieval plane]
        VDB[(Qdrant Cloud or Pinecone\nembeddings plus citation IDs\nworkspace-isolated vector namespace)]
        Rerank[Hybrid search and reranker]
        LLM[LLM answer generator\nsource-constrained]
    end

    User --> EdgeAccess --> API
    API --> PG
    API --> Admin
    API --> Query
    Query --> PG
    Query --> VDB
    Query --> Rerank --> LLM
    LLM --> Query
    Query --> User

    API --> Queue
    Queue --> Worker
    Worker --> Obj
    Worker --> PG
    Worker --> Embed
    Embed --> VDB
    Embed --> PG
    API --> Audit
    Query --> Audit
    Worker --> Audit

